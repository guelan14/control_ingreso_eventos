# Base de datos PostgreSQL.
#   Con Docker (npm run db:up):  postgres://eventos:eventos@localhost:5432/eventos
#   Sin Docker (Postgres embebido, solo desarrollo): pglite://./data/pglite
DATABASE_URL=postgres://eventos:eventos@localhost:5432/eventos

# Tamaño máximo del Excel a importar, en MB
IMPORT_MAX_MB=5
